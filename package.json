    "zod": "^4.1.5",
    "googleapis": "^150.0.1"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "1.20.16",
    "wrangler": "^4.158.0",
    "@types/node": "^22.18.6",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.4",
    "eslint": "^9.35.0",
    "eslint-config-next": "^15.5.29",
